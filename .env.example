# Run python3 scripts/setup_env.py to generate .env with private random keys.
APP_BASE_URL=http://localhost:8000
APP_PORT=8000
APP_PASSWORD=
TOKEN_ENCRYPTION_KEY=
# Provision these distinct accounts in local-infra; use URL-encoded passwords.
DATABASE_URL=postgresql+psycopg://octopus_assistant_runtime:SET_RUNTIME_PASSWORD@shared-postgres:5432/octopus_assistant
MIGRATION_DATABASE_URL=postgresql+psycopg://octopus_assistant_owner:SET_OWNER_PASSWORD@shared-postgres:5432/octopus_assistant
DATABASE_WAIT_SECONDS=60

FEISHU_APP_ID=
FEISHU_APP_SECRET=
# Optional: pin the intended user's open_id before the first authorization.
FEISHU_ALLOWED_OPEN_ID=
# Enable these user scopes in the app console, publish, then authorize.
FEISHU_SCOPES=offline_access contact:user.base:readonly im:chat:read im:message:readonly im:message.p2p_msg:get_as_user im:message.group_msg:get_as_user approval:task:read approval:instance:read approval:task:write

SYNC_PAGE_LIMIT=5
HTTP_TIMEOUT_SECONDS=15
SESSION_HOURS=24
# Personal conversations are reconciled through user APIs; events arrive over WSS.
SYNC_INTERVAL_SECONDS=60

# Review pending approvals continuously using exact rules or a bounded model decision.
APPROVAL_AUTOMATION_ENABLED=true
APPROVAL_POLICY_PATH=approval-policy.json
# approval:task:write must be granted before a matched rule can submit approval.
APPROVAL_MODEL_ENABLED=true
APPROVAL_MODEL=gpt-6-sol
APPROVAL_MODEL_REASONING_EFFORT=xhigh
APPROVAL_MODEL_URL=http://host.docker.internal:8181
APPROVAL_MODEL_TIMEOUT_SECONDS=300
# Run .venv/bin/python scripts/setup_model.py on the host before Docker startup.

# Important mentions and approvals awaiting owner input: 15 minutes, 24 hours/day.
ATTENTION_ENABLED=true
ATTENTION_TIMEOUT_SECONDS=900
# At most one phone attempt per 30 minutes, and once per source message.
ATTENTION_CALL_COOLDOWN_SECONDS=1800
# Enable bot scopes im:message:send_as_bot and im:message.urgent:phone in Feishu.
# Optional: exact DBA app and private chat IDs; DMS cards only trigger reminders.
DMS_SENDER_APP_ID=
DMS_CHAT_ID=
